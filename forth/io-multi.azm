; io-mcz80.azm
; I/O for FPGA based Z-80 Multicomputer system


; ------------------------------------------------------------------
; low-level I/O words for FPGA Multicomputer emulated UART ports
;RTS$HIGH        equ 0D5H
;RTS$LOW         equ 095H
;ACIA0$D         equ 081H
;ACIA0$C         equ 080H

ACIA1$D         equ 083H
ACIA1$C         equ 082H


;C EMIT     c --    output character to console
    head EMIT,4,'EMIT',docode
        LD B,C              ; put character to be transmitted in B from ToS
        LD A,ACIA1$C        ; eventually this comes from a parameter
        LD C,A
emit1:  IN A,(C)
        AND 0AH            ; n_cts and TX busy bits
        JR Z,emit1
        INC C               ; point to data port
        OUT (C),B
        POP BC              ; POP character off stack
        NEXT

;X KEY?     -- f    return true if char waiting
    head querykey,4,'KEY?',docode
        PUSH BC             ; raise stack
        LD A,ACIA1$C        ; eventually this comes from parameter
        LD C,A
        LD B,0
        IN A,(C)
        AND 01h             ; bit zero is data ready
        JR Z,qkey1
        LD C,0
        DEC BC              ; return -1
qkey1:
	NEXT

;C KEY      -- c    get character from keyboard
    head KEY,3,'KEY',docode
        LD A,ACIA1$C        ; eventually this comes from parameter
	PUSH BC		    ; raise stack
        LD C,A
        LD B,0
key1:   IN A,(C)
        AND 01h             ; bit zero is data ready
        JR Z,key1
        INC C               ; point to data port
        IN C,(C)            ; read character to top of stack (BC)
        NEXT

;X BYE     i*x --    return to CP/M
    head bye,3,'bye',docode
        DI
        out (39h),A  ; re-enable ROM
        jp 0         ;



; INIT - load first two blocks from the blocks file to boostrap
;        additional words into the forth environment.  The
;        code in the first block can load additional blocks
;        very carefully..
;X INIT      --  
  head bootextend,4,'INIT',docolon
    DW LIT,0,load$extend, LIT,1,load$extend, EXIT


;X NTEST   -- 42        return 42
    head NTEST,5,'NTEST',docode
	PUSH BC
	LD B,0
	LD C,42
;	NEXT
	DB 0EDh, 092h	; custom instruction
	
; NOTE: 2! and 2@ are already defined (as TWOSTORE/TWOFETCH) in
; camel80h.azm.  The duplicate definitions that used to live here were
; both broken (multiply-defined symbol, and ';'-comments miswritten as
; ':') and have been removed to let the module assemble.

; ------------------------------------------------------------------
; ------------------------------------------------------------------
; debugging output
;

putc:
                push    af
pc_wait:
                in      a,(ACIA1$C)
                and     02h
                jr      z,pc_wait
                pop     af
                out     (ACIA1$D),a
                ret

puts:
                ld      a,(hl)
                or      a
                ret     z
                call    putc
                inc     hl
                jr      puts

crlf:
                ld      a,0Dh
                call    putc
                ld      a,0Ah
                call    putc
                ret

puthex:
                push    af
                rrca
                rrca
                rrca
                rrca
                call    puthexnib
                pop     af
                call    puthexnib
                ret

puthexnib:
                and     00Fh
                add     a,090h
                daa
                adc     a,040h
                daa
                call    putc
                ret

puthex16:
                ld      a,h
                call    puthex
                ld      a,l
                call    puthex
                ret

afmsg: db "CF Regs  AF: ",0
hlmsg: db ", HL(W): ",0
demsg: db ", DE(IP): ",0
bcmsg: db ", BC(TOS): ",0
ixmsg: db ", IX(RSP): ",0
iymsg: db ", IY(UP): ",0
spmsg: db ", SP: ",0
newline: db 13,10,0
introdump:
	push af
	push hl
	push hl
	push af
	ld hl,afmsg ! call puts !           pop hl ! call puthex16
	ld hl,hlmsg ! call puts !           pop hl ! call puthex16
	ld hl,demsg ! call puts ! push de ! pop hl ! call puthex16
	ld hl,bcmsg ! call puts ! push bc ! pop hl ! call puthex16
	ld hl,ixmsg ! call puts ! push ix ! pop hl ! call puthex16
	ld hl,iymsg ! call puts ! push iy ! pop hl ! call puthex16	
	ld hl,spmsg ! call puts ! ld hl,0 ! add hl,sp ! call puthex16	
	ld hl,newline ! call puts
	pop hl
	pop af
	ret
	
; ------------------------------------------------------------------
; ------------------------------------------------------------------

RAMDISK EQU 1

 IFDEF RAMDISK
;  I/O words to access the preloaded "RAM Disk" that lives in the top
;  8 MB of the 128 MB SDRAM.  This was intended to preload a RAM disk
;  image for RomWBW, but we can take advantage of it here to pass in
;  plenty of FORTH blocks just lying around in memory.
;
;  The preloaded "disk image" starts at physical byte address
;  0x07800000 (page 7680 x 16 KB).  This matches the download path in
;  MultiComp.sv: dl_dsk_base = SDRAM_TOP - (slot+1)*8MB, so the first
;  RAM disk (slot 0) lands in the top 8 MB.  See IOPORTS.md.
;
;  The physical base is defined below as two 16-bit halves because the
;  M80-compatible assembler evaluates expressions as 16-bit and cannot
;  hold a full 32-bit constant.  To relocate the RAM disk, change these
;  two EQUs (and, if needed, the download base in MultiComp.sv).

RDBASELO EQU 0000h	; RAM-disk physical base, low  16 bits (0x07800000)
RDBASEHI EQU 0780h	; RAM-disk physical base, high 16 bits
B$BLK    EQU 1024	; FORTH block size in bytes (16 lines x 64 cols)

; MMU direct-access I/O ports (16-port window based at 0xB0):
;   0xB8     Direct access pointer, bits  7:0   (+8, little-endian, low first)
;   0xB9     Direct access pointer, bits 15:8   (+9)
;   0xBA     Direct access pointer, bits 23:16  (+10)
;   0xBB     Direct access pointer, bits 31:24  (+11)
;   0xBC     Direct access data port (+12).  Each R/W triggers a physical
;            memory access at the pointer; the pointer post-increments
;            after the access, so INIR/OTIR walk forward through memory.
MMUP0    EQU 0B8h	; direct-access pointer, byte 0
MMUDAT   EQU 0BCh	; direct-access data port (post-increment)

addressbase:
     dw RDBASELO,RDBASEHI	; 32-bit (doubleint) base address, LE
addressptr:
     dw RDBASELO,RDBASEHI	; 32-bit working pointer, LE

; --- FORTH introspection: expose the RAM-disk geometry / MMU ports ---

  head mmuaddrbase,11,'mmuaddrbase',docon
     dw addressbase

  head mmuaddrptr,10,'mmuaddrptr',docon
     dw addressptr

; RD-BASE ( -- a )  address of the 32-bit RAM-disk base; use  RD-BASE 2@
  head rd$base,7,'RD-BASE',docon
     dw addressbase

; B/BLK ( -- n )  FORTH block size in bytes
  head slashblk,5,'B/BLK',docon
     dw B$BLK

; MMU-PTR ( -- port )  MMU direct-access pointer base port (0xB8)
  head mmuptrport,7,'MMU-PTR',docon
     dw MMUP0

; MMU-DAT ( -- port )  MMU direct-access data port (0xBC)
  head mmudatport,7,'MMU-DAT',docon
     dw MMUDAT

; RD>MEM ( phys-lo phys-hi c-addr count -- )
;   Copy 'count' bytes from RAM-disk physical address (phys-hi:phys-lo)
;   into Z-80 logical memory at c-addr, using the MMU direct-access
;   window.  The four pointer bytes are written low-first, then the data
;   is streamed through the auto-incrementing data port with INIR (each
;   INIR moves up to 256 bytes; we loop for larger counts).
  head rdtomem,6,'RD>MEM',docode
	; Register conventions: DE (IP), IX (RSP), IY (UP) MUST be preserved.
	; All scratch work is done in the alternate register set (like FILL and
	; CMOVE) so the main DE=IP is never touched.  SP is not banked, so the
	; POPs below still take cells off the parameter stack.
	;
	; Stack model on entry (Forth TOS is in main BC):
	;   BC       = count
	;   (sp)+0   = c-addr   (destination, popped first)
	;   (sp)+2   = phys-hi
	;   (sp)+4   = phys-lo
	push bc			; TOS(count) -> param stack
	exx			; alternate set now active; main DE=IP preserved
	; alt stack (SP shared) top-down: count, c-addr, phys-hi, phys-lo, ...
	pop bc			; bc' = count
	pop hl			; hl' = c-addr (destination pointer for INIR)
	; set the 32-bit MMU pointer from the next two cells (phys-hi, phys-lo).
	; phys-hi is on top now, phys-lo below it.
	pop de			; de' = phys-hi
	ex (sp),hl		; (sp) <- c-addr(dest) ; hl' <- phys-lo
	; now: hl'=phys-lo, de'=phys-hi, bc'=count, (sp)=dest, DE(main)=IP
	push bc			; save count (machine stack)
	ld c,MMUP0
	out (c),l		; +0  bits  7:0
	inc c
	out (c),h		; +1  bits 15:8
	inc c
	out (c),e		; +2  bits 23:16
	inc c
	out (c),d		; +3  bits 31:24
	pop bc			; bc' = count (restored)
	pop hl			; hl' = dest pointer (restored)
	; stream 'bc' bytes from MMUDAT into (hl'); 256-byte chunks via INIR
	ld d,b			; d' = count high (whole-256 chunk counter)
	ld e,c			; e' = count low  (final partial count)
	ld c,MMUDAT
rdmem1:	ld a,d			; whole 256-byte chunks remaining?
	or a
	jr z,rdmem2		; none: do the final partial chunk
	ld b,0			; b'=0 => INIR transfers 256 bytes

rdmem4:	in a,(c)                ; ** slower INIR to avoid SDRAM problem
	ld (hl),a               ; ** slower INIR to avoid SDRAM problem
	inc hl                  ; ** slower INIR to avoid SDRAM problem
	dec b                   ; ** slower INIR to avoid SDRAM problem
	jr nz,rdmem4            ; ** slower INIR to avoid SDRAM problem

	dec d
	jr rdmem1
rdmem2:	ld a,e			; low byte = remaining bytes (0..255)
	or a
	jr z,rdmem3
	ld b,e

rdmem5:	in a,(c)                ; ** slower INIR to avoid SDRAM problem
	ld (hl),a               ; ** slower INIR to avoid SDRAM problem
	inc hl                  ; ** slower INIR to avoid SDRAM problem
	dec b                   ; ** slower INIR to avoid SDRAM problem
	jr nz,rdmem5            ; ** slower INIR to avoid SDRAM problem

rdmem3:	exx			; back to the main register set (DE=IP intact)
	pop bc			; refill Forth TOS with the new top cell
	next

; MEM>RD ( phys-lo phys-hi c-addr count -- )
;   The write counterpart of RD>MEM: copy 'count' bytes from Z-80 logical
;   memory at c-addr OUT to the RAM-disk physical address (phys-hi:phys-lo),
;   using the MMU direct-access window.  Same pointer set-up as RD>MEM, then
;   the data is streamed to the auto-incrementing data port with OTIR.
  head memtord,6,'MEM>RD',docode
	; Same alternate-register-set discipline as RD>MEM; DE=IP preserved.
	; Stack model on entry (Forth TOS in main BC = count):
	;   (sp)+0 = c-addr (source)   (sp)+2 = phys-hi   (sp)+4 = phys-lo
	push bc			; TOS(count) -> param stack
	exx			; alternate set active; main DE=IP preserved
	pop bc			; bc' = count
	pop hl			; hl' = c-addr (source pointer for OTIR)
	pop de			; de' = phys-hi
	ex (sp),hl		; (sp) <- c-addr(src) ; hl' <- phys-lo
	push bc			; save count
	ld c,MMUP0
	out (c),l		; +0  bits  7:0
	inc c
	out (c),h		; +1  bits 15:8
	inc c
	out (c),e		; +2  bits 23:16
	inc c
	out (c),d		; +3  bits 31:24
	pop bc			; bc' = count (restored)
	pop hl			; hl' = source pointer (restored)
	ld d,b			; d' = count high (whole-256 chunk counter)
	ld e,c			; e' = count low  (final partial count)
	ld c,MMUDAT
wrmem1:	ld a,d			; whole 256-byte chunks remaining?
	or a
	jr z,wrmem2		; none: do the final partial chunk
	ld b,0			; b'=0 => OTIR transfers 256 bytes

wrmem4:	ld a,(hl)               ; ** slower OTIR to avoid SDRAM problem
	out (c),a               ; ** slower OTIR to avoid SDRAM problem
	inc hl                  ; ** slower OTIR to avoid SDRAM problem
	dec b                   ; ** slower OTIR to avoid SDRAM problem
	jr nz,wrmem4            ; ** slower OTIR to avoid SDRAM problem

	dec d
	jr wrmem1
wrmem2:	ld a,e			; low byte = remaining bytes (0..255)
	or a
	jr z,wrmem3
	ld b,e

wrmem5:	ld a,(hl)               ; ** slower OTIR to avoid SDRAM problem
	out (c),a               ; ** slower OTIR to avoid SDRAM problem
	inc hl                  ; ** slower OTIR to avoid SDRAM problem
	dec b                   ; ** slower OTIR to avoid SDRAM problem
	jr nz,wrmem5            ; ** slower OTIR to avoid SDRAM problem

wrmem3:	exx			; back to the main register set (DE=IP intact)
	pop bc			; refill Forth TOS with the new top cell
	next

; >PHYS ( blk# -- phys-lo phys-hi )
;   Compute the RAM-disk physical address of FORTH block 'blk#':
;       base + blk# * 1024
;   Returns the 32-bit result as two cells (low then high) so it can be
;   fed straight into RD>MEM.  32-bit math done here in assembly because
;   the kernel has no D+ .
  head tophys,5,'>PHYS',docode
	; Register conventions: DE (IP) MUST be preserved.  The 32-bit multiply
	; uses DE as a scratch accumulator, so do it in the alternate set.
	; ( blk# -- phys-lo phys-hi ) : main BC = blk# (TOS) on entry.
	push bc			; blk# -> param stack
	exx			; alternate set active; main DE=IP preserved
	pop bc			; bc' = blk#
	ld h,b
	ld l,c			; hl' = blk#
	ld de,0			; de' = high word accumulator
	; multiply by 1024 = shift left 10 bits, propagating into DE'
	ld a,10
phys1:	add hl,hl		; hl' <<= 1
	ex de,hl
	adc hl,hl		; de' <<= 1 with carry in from hl'
	ex de,hl
	dec a
	jr nz,phys1
	; add the 32-bit base (RDBASEHI:RDBASELO)
	ld bc,RDBASELO
	add hl,bc		; low word + base low
	ex de,hl
	ld bc,RDBASEHI
	adc hl,bc		; high word + base high + carry
	ex de,hl
	; hl' = phys-lo, de' = phys-hi.
	push hl			; phys-lo -> param stack
	push de			; phys-hi -> param stack (becomes new TOS)
	exx			; back to main set (DE=IP intact)
	pop bc			; main BC = phys-hi (new TOS)
	next

; -------------------------------------------------------------------
; Block-file interface compatible with the CP/M version in io-cpm.azm,
; so the portable block-buffer / editor code in blocks/*-blocks.fth,
; blocks/*-editor.fth, etc. runs unchanged.  Instead of a CP/M file,
; the "file" is the RAM disk: block N occupies RAM-disk bytes
; N*1024 .. N*1024+1023 (see >PHYS).  FCB$ is a dummy, non-zero handle
; the block layer stashes in BHNDL to mean "open".
; -------------------------------------------------------------------

fcb$buf:  DS 2		; dummy handle storage (contents unused)

; FCB$ ( -- a )   opaque, non-zero file handle used by the block layer
  head fcb$,4,'FCB$',docon
     dw fcb$buf

; open-file ( -- )   no-op for the RAM disk; the block layer immediately
;   does  open-file FCB$ BHNDL !  so the handle comes from FCB$, and this
;   word only has to leave the stack unchanged and "succeed".
  head open$file,9,'open-file',docolon
     DW EXIT

; read-file  ( block# buffer-adr -- )
;   Read one 1024-byte block from the RAM disk into buffer-adr.  Called
;   this way by RBLK:  SWAP DUP >R read-file R>  (buffer preserved there).
  head read$file,9,'read-file',docolon
     DW SWOP			; ( buf block# )
     DW tophys			; ( buf phys-lo phys-hi )
     DW ROT			; ( phys-lo phys-hi buf )
     DW lit,B$BLK		; ( phys-lo phys-hi buf count )
     DW rdtomem
     DW EXIT

; write-file ( block# buffer-adr -- )
;   Write one 1024-byte block from buffer-adr out to the RAM disk.
;   Called by WBLK:  SWAP write-file .
  head write$file,10,'write-file',docolon
     DW SWOP			; ( buf block# )
     DW tophys			; ( buf phys-lo phys-hi )
     DW ROT			; ( phys-lo phys-hi buf )
     DW lit,B$BLK		; ( phys-lo phys-hi buf count )
     DW memtord
     DW EXIT

; LOAD ( blk# -- )   load and interpret one 1024-byte FORTH block from
;                    the RAM disk.  Uses BLKBUF (see camel80h.azm), the
;                    dynamically-allocated one-block transfer buffer,
;                    rather than a hard-coded address.
;
; Two interpretation strategies, selected at assembly time:
;
;   LOADLINES undefined (default):
;       Whole-block mode.  The entire 1024-byte block is handed to
;       EVALUATE in one call, so a single colon definition may span
;       several of the 64-column lines within the block.
;
;   LOADLINES defined (e.g.  um80 -D LOADLINES ...  or uncomment below):
;       Classic per-line "screen" mode.  Each of the 16 lines is echoed
;       with its line number and EVALUATEd on its own.  A definition
;       must then fit entirely on one 64-column line.
;
LOADLINES EQU 1				; <- uncomment for classic per-line screen behaviour
;
  head load$extend,4,'LOAD',docolon
	; pull the block into BLKBUF via the MMU direct-access window
	DW tophys			; ( blk# -- phys-lo phys-hi )
	DW BLKBUF,FETCH, lit,B$BLK
	DW rdtomem			; ( phys-lo phys-hi c-addr count -- )
  IFDEF LOADLINES
	; --- classic per-line screen interpretation ---
	DW lit,10h, lit,0, xdo		; 16 lines
LOAD1:
	DW BLKBUF,FETCH, II, lit,40h, STAR, PLUS  ; addr of this 64-col line
	DW lit,40h			; length = 64
	DW TWODUP, CR			; ( addr len addr len ) show it below
	DW BASE, FETCH, DECIMAL, II, DOT, BASE, STORE  ; echo line number
	DW lit,3Eh, EMIT		; '>' prompt
	DW SPACE, TYPE			; print the line text
	DW EVALUATE			; interpret this line
	DW xloop, LOAD1
  ELSE
	; --- whole-block interpretation (definitions may span lines) ---
	DW BLKBUF,FETCH, lit,B$BLK
	DW EVALUATE
  ENDIF
	DW EXIT

; *********************************************************
; *********************************************************
; TESTING words
; *********************************************************
  ; inirtest ( rambuf -- )
  
  head inirtest,8,'inirtest',docode
       ld h,b    ; get address from ToS
       ld l,c
       ld c,MMUDAT
       ld b,0    ; 256 bytes
       inir

       pop bc    ; get new TOS
       NEXT

; *********************************************************
; *********************************************************



 ELSE

; ------------------------------------------------------------------
; ------------------------------------------------------------------

; low-level I/O words for Multicomputer SD card disk I/O, based
; on the FPGA's SD card component.   This driver adapted from the
; Multicomputer CP/M 3 BIOS code.
;
;

;; Address Register
;;    0    SDDATA        read/write data
;;    1    SDSTATUS      read
;;    1    SDCONTROL     write
;;    2    SDLBA0        write-only
;;    3    SDLBA1        write-only
;;    4    SDLBA2        write-only (only bits 6:0 are valid)
;;
;; For both SDSC and SDHC (high capacity) cards, the block size is 512bytes (9-bit value) and the
;; SDLBA registers select the block number. SDLBA2 is most significant, SDLBA0 is least significant.

;; For SDHC cards, the read/write address parameter is the ordinal number of 512-byte block ie, the
;; 9 low address bits are implicity 0. The 24 programmable address bits select the 512-byte block.
;; This gives an address capacity of 2^24 * 512 = 8GByte. SDHC can be upto 32GByte but this design
;; can only access the low 8GByte (could add SDLBA3 to get the extra address lines if required).
;;
;; The SDLBA registers are used like this:
;;
;; 31 30 29 28.27 26 25 24.23 22 21 20.19 18 17 16.15 14 13 12.11 10 09 08.07 06 05 04.03 02 01 00
;;  0  0  0  0  0  0  0  0+---------- SDLBA2 -----+------- SDLBA1 --------+------- SDLBA0 --------+
;;
;; The end result of all this is that the addressing looks the same for SDSC and SDHC cards.
;;
;; SDSTATUS (RO)
;;    b7     Write Data Byte can be accepted
;;    b6     Read Data Byte available
;;    b5     Block Busy
;;    b4     Init Busy
;;    b3     Unused. Read 0
;;    b2     Unused. Read 0
;;    b1     Unused. Read 0
;;    b0     Unused. Read 0
;;
;; SDCONTROL (WO)
;;    b7:0   0x00 Read block
;;           0x01 Write block
;;
;;
;; To read a 512-byte block from the SDCARD:
;; Wait until SDSTATUS=0x80 (ensures previous cmd has completed)
;; Write SDLBA0, SDLBA1 SDLBA2 to select block index to read from
;; Write 0 to SDCONTROL to issue read command
;; Loop 512 times:
;;     Wait until SDSTATUS=0xE0 (read byte ready, block busy)
;;     Read byte from SDDATA
;;
;; To write a 512-byte block to the SDCARD:
;; Wait until SDSTATUS=0x80 (ensures previous cmd has completed)
;; Write SDLBA0, SDLBA1 SDLBA2 to select block index to write to
;; Write 1 to SDCONTROL to issue write command
;; Loop 512 times:
;;     Wait until SDSTATUS=0xA0 (block busy)
;;     Write byte to SDDATA

SD$DATA         equ 088H
SD$CONTROL      equ 089H
SD$STATUS       equ 089H
SD$LBA0         equ 08AH
SD$LBA1         equ 08BH
SD$LBA2         equ 08CH

SD$OUT          equ 0
SD$IN           equ 1


; The SD card FPGA component does 512 byte transfers to a linear
; array of sectors. 

; 24 bit LBA address
; each 8MB volume has 16384 (512 byte) blocks - 14 bits
;
;; 31 30 29 28.27 26 25 24.23 22 21 20.19 18 17 16.15 14 13 12.11 10 09 08.07 06 05 04.03 02 01 00
;;  0  0  0  0  0  0  0  0+---------- SDLBA2 -----+------- SDLBA1 --------+------- SDLBA0 --------+
;;                            \--  Volume number [8b]--/ \-- SD (512 byte) Block number  [14b] --/


; file-io  ( operation block# buffer-adr -- status )
  head file$io,7,'io-file',docolon
;    dw LIT,26, BDOS, DROP   ; set DMA address
;    dw LIT,8, LIT,44, BDOS, DROP    ; set multi-sector count
;    dw file$seek
;   dw FCB$, SWOP, BDOS

    dw DROP,DROP,DROP,LIT,-1
    dw EXIT

; seek-file  ( block-num -- )
  head file$seek,9,'seek-file',docolon
;    dw LIT,3, LSHIFT    ; multiply block number by 8 for CPM rec#
;    dw FCB$, LIT,33, PLUS, STORE       ; store CP/M rec into FCB random rec#
;    dw LIT,0, LIT,35, fcb$, PLUS, CSTORE     ; zero record extension

    dw DROP, LIT,-1
    dw EXIT

; read-file
  head read$file,9,'read-file',docolon
;    dw LIT,33, ROT, ROT, file$io
;    dw DROP  ; ignore status

    dw DROP
    dw EXIT

; write-file
  head write$file,10,'write-file',docolon
;    dw LIT,40, ROT, ROT, file$io
;    dw DROP  ; ignore status    

    dw EXIT


; load - load and evaluate a block from the (open)
;        block file.   Pretty bare-bones and expected
;        to be replaced by a more sophisticated version
;        from the FORTH environment extended after loading
;
; Uses BLKBUF (see camel80h.azm), the dynamically-allocated one-block
; transfer buffer, rather than a hard-coded address.
;
;     HEX
;     : LOAD (blocknum -- ) open-file BLKBUF @ read-file
;       10 0 DO BLKBUF @ I 40 * + 40 2DUP CR BASE @ DECIMAL I . BASE ! 3E EMIT
;       SPACE TYPE EVALUATE LOOP ;
  head load$extend,4,'LOAD',docolon
;    DW open$file
;    DW BLKBUF,FETCH, read$file
;    DW LIT,10h, LIT,0, XDO
LOAD1:
;    DW BLKBUF,FETCH, II
;    DW LIT,40h, STAR, PLUS
;    DW LIT,40h, TWODUP, CR
;    DW BASE, FETCH, DECIMAL, II, DOT, BASE, STORE
;    DW LIT,3Eh, EMIT
;    DW SPACE, TYPE, EVALUATE
;    DW XLOOP,LOAD1

    DW DROP

    DW EXIT

 ENDIF
