// clocks.dot -- clock domains, the reset tree, and every clock-domain crossing.
// Parent sheet: overview.dot.
//
// Regenerate:  make -C doc/architecture
// Sources: MrZ80.sv (pll, reset, download, SDRAM CDC), MicrocomputerZ80CPM.vhd
// (cpu_cen, baud and SD dividers), ssp/rtl/ssp_tramp.vhd.

digraph clocks {

    graph [rankdir  = LR,
           ranksep  = 0.7,
           nodesep  = 0.24,
           fontname = "Helvetica",
           fontsize = 13,
           labelloc = "t",
           labeljust= "l",
           label    = "Clock domains, resets and the crossings between them\nThe core runs on its own PLL outputs; the MiSTer framework's video and audio clocks stay on the far side of the boundary."];

    node [shape = box, style = "rounded,filled", fontname = "Helvetica",
          fontsize = 11, margin = "0.12,0.08"];
    edge [fontname = "Helvetica", fontsize = 9];

    clk50 [label = "CLK_50M\nboard 50 MHz", fillcolor = "#fff3cd"];

    pll [label = "pll (rtl/pll.v, MegaWizard IP)\noutclk_0 -> clk_sys 50 MHz\noutclk_1 -> clk_ram ~112 MHz\n\nfallback define SDRAM_CLK_100 takes\na 100 MHz tap instead, if the SDRAM\npaths fail timing closure\n\nlocked is not used to gate anything", fillcolor = "#fff3cd"];

    dom_sys [label = "domain: clk_sys, 50 MHz\n\nthe whole Z-80 computer, MMU,\nperipherals, PSG, SSP, hps_io and\nthe download path\n\nhps_io deliberately runs on clk_sys,\nnot CLK_50M, so status, ioctl and\nthe block-device buffer are already\nsynchronous where they are used", fillcolor = "#e8f1fb"];

    dom_ram [label = "domain: clk_ram, ~112 MHz\n\nsdram_32r8w controller only", fillcolor = "#e8f1fb"];

    dom_vid [label = "video\n\nCLK_VIDEO = clk_sys, and the\nterminal's pixel enable comes\nfrom the framework's CE_PIXEL;\nboth text terminals run free-\nrunning counters on clk_sys", fillcolor = "#e8f1fb"];

    slow [label = "clk_sys dividers\ncpu_cen: 1 in 5 -> 10 MHz Z-80\nserialClock: baud DDS, an accumulator\nwith baud_increment, bit 15 out\n(115200 = 2416 ... 2400 = 50)\nsdClock: SPI shift clock for the\nSD card controller", fillcolor = "#fff3cd"];

    rst [label = "reset tree\n\nRESET_sync   framework RESET, 2-FF'd\nreset_sys    RESET_sync | OSD Reset (status[0])\n         | user button | reset-after-mount\n         | download in progress | post-download stretch\nreset      reset_sys | ~bin_loaded\n   (there is no boot ROM: the CPU is held until\n   a .BIN image has been loaded; OSD Reset and the\n   user button only restart the loaded image)\nsdram_init  hard RESET_sync only - never during\n   a download, which would wipe the bytes arriving\nssp_rst_n   status[23] stretched to ~1.3 ms\nz_reset_n   SSP vent, extended VENT_CEN cpu_cen\n   pulses in ssp_tramp so a short pulse resets cleanly", fillcolor = "#fff3cd"];

    x1 [label = "clk_sys -> clk_ram\nSDRAM request\nheld request level (we|rd) 2-FF\nsynchronised, then edge-detect;\naddr/data latched at the request,\nstable for the whole transaction", fillcolor = "#ffe0b2"];

    x2 [label = "clk_ram -> clk_sys\ncompletion\n\nram_done toggles; back in clk_sys it\nis 2-FF'd and XOR-ed for a one-cycle\nready pulse", fillcolor = "#ffe0b2"];

    x3 [label = "clk_sys -> clk_ram\ncontroller init\n\nregistered once in clk_sys first (so a\nglitch between its sources cannot reach\nclk_ram), then 2-FF synchronised: all\ncontroller registers change together", fillcolor = "#ffe0b2"];

    x4 [label = "framework -> core\nhps_rtc, PS/2,\nioctl_* / sd_*\n\nhps_io is synchronous to clk_sys; the\nRTC model re-synchronises the BCD plus\ntoggle bit into its own read clock", fillcolor = "#ffe0b2"];

    clk50 -> pll;
    pll -> dom_sys [label = "clk_sys"];
    pll -> dom_ram  [label = "clk_ram"];
    dom_sys -> dom_vid;
    dom_sys -> slow;
    dom_sys -> rst;
    dom_sys -> x1 [style = invis];
    x1 -> dom_ram [label = "ram_req,\nram_rnw, addr, din"];
    dom_ram -> x2 [label = "ack, ready, dout16"];
    rst -> x3;
    x3 -> dom_ram [label = "init"];
    x4 -> dom_sys;
    rst -> dom_sys [label = "CPU + peripherals"];
    rst -> dom_ram [label = "controller init", style = dashed];
}
