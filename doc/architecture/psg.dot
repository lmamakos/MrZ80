// psg.dot -- dual YM2149 sound: the MrZ80 wrapper and the vendored core.
// Parent sheet: overview.dot.  Port windows and SELECT values: iomap.dot.
//
// Regenerate:  make -C doc/architecture
// Sources: Components/PSG/MrZ80_PSG.sv, Components/PSG/BHG_jt49_exp_q17.sv,
// Components/YM2149/*  (vendored, unmodified), MrZ80.qsf (macros).

digraph psg {

    graph [rankdir  = LR,
           ranksep  = 0.68,
           nodesep  = 0.22,
           fontname = "Helvetica",
           fontsize = 13,
           labelloc = "t",
           labeljust= "l",
           label    = "Dual YM2149 / AY-3-8910 sound\nTwo PSGs behind one vendored system core; the MrZ80 wrapper adds AY-style SELECT latches, a mixer register window and a silent-at-reset pan sequencer."];

    node [shape = box, style = "rounded,filled", fontname = "Helvetica",
          fontsize = 11, margin = "0.12,0.08"];
    edge [fontname = "Helvetica", fontsize = 9];

    subgraph cluster_ports {
        label     = "Z-80 I/O ports";
        color     = "#e65100";
        style     = "rounded";
        fontcolor = "#bf360c";
        bgcolor   = "#fff6ee";

        p1 [label = "$50 SELECT, $51 DATA\n(device 1)", fillcolor = "#ffcc80"];
        p2 [label = "$68 SELECT, $60 DATA\n(device 2)", fillcolor = "#ffcc80"];
        rd [label = "reads return the selected\nregister on both ports;\ninvalid select -> $FF", fillcolor = "#ffe0b2"];
    }

    subgraph cluster_wrap {
        label     = "MrZ80_PSG.sv  (this project)";
        color     = "#6a1b9a";
        style     = "rounded";
        fontcolor = "#4a148c";
        bgcolor   = "#f8f0fc";

        latch [label = "SELECT latches\n\nsel1 from $50, sel2 from $68\nsteering: sel nibble 0 -> PSG A\n8 -> left mixer, 9 -> right mixer\n(device 1); device 2 is forced to\nnibble 1 -> PSG B\nany other nibble deselects that\ndevice: writes dropped, $FF read", fillcolor = "#e1bee7"];

        seq [label = "mute + pan sequencer\n\nat reset the PSG registers are 0 so no tone,\nbut the mixer's DC filter takes ~12 ms per\ntime constant to centre the DAC's constant\nlevel - an audible thump.  So: mute both\nmaster volumes, wait SETTLE_CYCLES (200 ms,\n~17 time constants), write the selected\npanning, clear phase invert, restore master\nto 128.\n\nA later OSD change rewrites only the six\ngains of each side, so software's master\nvolume, invert, bass and treble survive it", fillcolor = "#e1bee7"];

        pan [label = "pan table (OSD PSG Stereo,\nstatus[26:25])\n\n0 Mono  all six channels at 64 both sides\n1 ABC   A left, B centre, C right\n2 ACB   A left, C centre, B right\n3 treated as Mono\n\npartial split 96/64/32 of 256 (3:1), so a\nchannel never vanishes from one ear; the\nper-side gain sum stays 384 in every mode\nso loudness does not change.  Device 2\n(D,E,F) is panned like device 1", fillcolor = "#e1bee7"];
    }

    osd [label = "MiSTer OSD\n\"PSG Stereo\" = status[26:25]", fillcolor = "#e0e0e0", color = "#9e9e9e"];

    subgraph cluster_vendored {
        label     = "YM2149_PSG_system  (vendored Components/YM2149, unmodified)";
        color     = "#4a148c";
        style     = "rounded";
        fontcolor = "#4a148c";
        bgcolor   = "#f3e5f5";

        div [label = "BHG_FP_clk_divider\nprecision divider from\nclk_sys 50 MHz to\nCLK_PSG_HZ = 1.789772 MHz\n+ sample strobe", fillcolor = "#d1c4e9"];

        psga [label = "BHG_jt49  PSG A\nchannels A,B,C\ntone + noise + envelope\nYM2149_DAC_BITS = 10", fillcolor = "#d1c4e9"];
        psgb [label = "BHG_jt49  PSG B\nchannels D,E,F\n(USE_DUAL_PSG)", fillcolor = "#d1c4e9"];

        mixl [label = "BHG_audio_filter_mixer LEFT\n6 channel gains, DC filter, bass/treble,\nmaster volume, per-channel invert\nregs 0..9 = VolA..VolF, mvol,\nINV{xxFEDCBA}, bass, treb\nselected by addr nibble 8", fillcolor = "#d1c4e9"];
        mixr [label = "BHG_audio_filter_mixer RIGHT\nsame registers, addr nibble 9\n(USE_STEREO)\nMIXER_DAC_BITS = 16", fillcolor = "#d1c4e9"];

        exp [label = "BHG_jt49_exp_q17\nthis project's Quartus-17 drop-in for\nthe vendored BHG_jt49_exp (whose LUT\ninclude trips Quartus 17 error 10748)\ngenerated by tools/gen_bhg_lut.py,\nvalue-for-value identical; the vendored\nfile stays in the tree, uncompiled", fillcolor = "#ede7f6"];
    }

    out [label = "audio_l / audio_r\n16-bit signed -> MiSTer\naudio_out (HDMI + I2S)", fillcolor = "#e0e0e0", color = "#9e9e9e"];

    p1 -> latch; p2 -> latch;
    latch -> rd [style = dashed];
    osd -> pan [color = "#6a1b9a"];
    pan -> seq [color = "#6a1b9a"];
    latch -> psga [label = "addr/data/wr_n\nnibble 0"];
    latch -> psgb [label = "nibble 1"];
    latch -> mixl [label = "nibble 8"];
    latch -> mixr [label = "nibble 9"];
    seq   -> mixl [label = "gains, mvol, invert", color = "#6a1b9a"];
    seq   -> mixr [label = "gains, mvol, invert", color = "#6a1b9a"];
    div -> psga [label = "PSG clock"];
    div -> psgb [label = "PSG clock"];
    psga -> mixl [label = "A,B,C"]; psga -> mixr [label = "A,B,C"];
    psgb -> mixl [label = "D,E,F"]; psgb -> mixr [label = "D,E,F"];
    psga -> exp [style = dotted, label = "envelope LUT", color = "#6a1b9a"];
    mixl -> out [label = "left", color = "#6a1b9a"];
    mixr -> out [label = "right", color = "#6a1b9a"];
}
