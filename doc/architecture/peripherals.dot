// peripherals.dot -- the Z-80 I/O devices and what they connect to off-core.
// Parent sheet: overview.dot.  Address windows: iomap.dot.
//
// Regenerate:  make -C doc/architecture
// Sources: MicrocomputerZ80CPM.vhd, Components/TERMINAL, Components/UART,
// Components/SDCARD, Components/RTC, Components/TIMER, Components/FRONTPANEL.

digraph peripherals {

    graph [rankdir  = LR,
           ranksep  = 0.7,
           nodesep  = 0.2,
           fontname = "Helvetica",
           fontsize = 13,
           labelloc = "t",
           labeljust= "l",
           label    = "Z-80 I/O peripherals\nEach device owns a window; the CPU sees one read-data mux and one wired-AND interrupt line."];

    node [shape = box, style = "rounded,filled", fontname = "Helvetica",
          fontsize = 11, margin = "0.12,0.08"];
    edge [fontname = "Helvetica", fontsize = 9];

    cpu [label = "Z-80 bus\n(see z80.dot)\n\nA[7:0] select, A[2:0] or A[0]\nfor the register inside a window\nIORQ + RD/WR strobes", fillcolor = "#bbdefb"];

    dec [label = "chip-select decode\n$70-$71, $80-$81, $82-$83, $88-$8F,\n$90-$97, $A0-$A7, $C0-$CF,\n$D0-$D3, $FF", fillcolor = "#ffe0b2"];

    term [label = "SBCTextDisplayRGB   $80 data, $81 status/control\n\n6850 ACIA semantics, including master reset\n(a control write with bits 1:0 = 11 holds the\nstatus at 0 and empties the keyboard buffer -\nwhat RomWBW's ACIA driver probes for)\n16-key buffer, ESC sends 1B, arrows and\nfunction keys send VT100/xterm sequences\nCGA font ROM, 2-bit RGB colour video output\nkbEnable drops keys while the SSP terminal\nhas the keyboard", fillcolor = "#ffcc80"];

    uart [label = "bufferedUART   $82 data, $83 status/control\n\nACIA-style register view, RTS/CTS optional\nrx/tx clocked by the serial baud DDS\n(serialClkCount + baud_increment, bit 15)\nshared with the SSP over the console mux", fillcolor = "#ffcc80"];

    sd   [label = "sd_controller   $88-$8F\n\nraw SPI to the physical SD socket\n+0 DATA, +1 STATUS, +2..+4 address bytes\n(SDSC byte address or SDHC block address),\n+5..+7 debug state\nsdClock from a clk_sys divider, driveLED out", fillcolor = "#bcaaa4"];

    bd   [label = "hps_blockdev   $90-$97\n\nidentical register layout to sd_controller, so\none driver serves both - but there is no SPI:\nasks the HPS to move one 512-byte block\nbetween a mounted image and a sector buffer\nreports image size and read-only state", fillcolor = "#bcaaa4"];

    rtc  [label = "ds12887   $70 index, $71 data\n\nRTC register file modelled; date and time\nare supplied by the MiSTer HPS (hps_rtc,\nBCD plus a once-a-minute toggle)\nread-back is coherent across clocks", fillcolor = "#eeeeee"];

    bt   [label = "BenchTimer   $C0-$CF\n\nfour free-running 32-bit counters,\nOUT to a channel latches it,\nIN reads the latch little-endian\nch 0/1 tick at 1 ms, ch 2/3 at 1 us", fillcolor = "#c8e6c9"];

    it   [label = "IntervalTimer   $D0-$D3\n\n$D0/1 interval lo/hi, $D2 control\n(bit 0 run, bit 1 interrupt enable,\nbit 2 auto-reload), $D3 restart\nthe RomWBW system tick", fillcolor = "#c8e6c9"];

    chain [label = "signal capture chains\nTransparent_Capture_Chain x5 +\nUniversal_Capture_Chain\n\n384 bits latched together: address,\nwrite data, control strobes, CPU state\n(iff/im/PC-side registers), IRQ levels,\nthe $FF latch", fillcolor = "#cfd8dc"];

    fp   [label = "FrontPanel_Subsystem   $A0-$A7\n\n8 profiles x 256 WS2812/SK6812 LEDs\ncolour RAM, chain-map RAM, framebuffer\n+0 brightness, +2 pointer, +3 colour stream,\n+4 mode, +5 map, +6 framebuffer, +7 profile\nrefresh tick drives the single-wire PHY\nprofile from the OSD file (.FPP) or the\nOSD profile override, without the Z-80", fillcolor = "#cfd8dc"];

    irq  [shape = point, style = filled, fillcolor = "#e65100", width = 0.14, height = 0.14];

    fw [label = "MiSTer framework (sys/)\n\nUSB keyboard -> PS/2 signals\nblock interface sd_lba / sd_rd / sd_wr /\nsd_ack / sd_buff_*, img_mounted, img_size\nclock-of-day, SD socket pins,\nUSER_OUT[6] for the LED string,\nvideo capture, audio, OSD", fillcolor = "#e0e0e0", color = "#9e9e9e"];

    cpu -> dec;
    dec -> term; dec -> uart; dec -> sd; dec -> bd;
    dec -> rtc;  dec -> bt;   dec -> it; dec -> chain; dec -> fp;
    term -> cpu [label = "read data"]; uart -> cpu; sd -> cpu; bd -> cpu;
    rtc -> cpu;  bt -> cpu;   it -> cpu; fp -> cpu;
    chain -> fp [label = "chain bits", color = "#e65100"];
    cpu -> chain [label = "captured nets", style = dotted, color = "#e65100"];

    term -> irq; uart -> irq; it -> irq;
    irq -> cpu [label = "INT_n\n(wired-AND, held off\nby ssp_int_hold)", color = "#e65100", style = dashed];

    fw -> term [label = "PS/2 keyboard"];
    fw -> bd   [dir = both, label = "one 512-byte block at a time"];
    fw -> rtc  [label = "hps_rtc", style = dashed];
    sd -> fw   [label = "SPI pins"];
    fp -> fw   [label = "WS2812 stream"];
}
