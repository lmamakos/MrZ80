// overview.dot -- the MrZ80 core at a glance, outside the sys/ framework.
// Companion to mrz80-core.dot (detail) and iomap.dot (port map); the tables in
// doc/ARCHITECTURE.md carry the remaining specifics.
//
// Regenerate:  make -C doc/architecture

digraph MrZ80_overview {

    graph [rankdir  = LR,
           ranksep  = 0.7,
           nodesep  = 0.3,
           fontname = "Helvetica",
           fontsize = 14,
           labelloc = "t",
           labeljust= "l",
           label    = "MrZ80 -- one-screen overview\nA 10 MHz T80 Z-80 with a paged MMU over 128 MB of SDRAM, its peripherals, dual YM2149 sound and a RISC-V debug processor, on a MiSTer Cyclone V."];

    node [shape = box, style = "rounded,filled", fontname = "Helvetica",
          fontsize = 12, margin = "0.14,0.10"];
    edge [fontname = "Helvetica", fontsize = 10];

    fw [label = "MiSTer framework\nsys/ -- never modified\n\nOSD, HDMI/VGA, audio out\nHPS bridge: files, disk images,\nUSB keyboard, clock-of-day\nSD socket, GPIO, the SDRAM chip",
          fillcolor = "#e0e0e0", color = "#9e9e9e"];

    glue [label = "core glue -- MrZ80.sv\n\nPLL: 50 MHz system,\n112 MHz SDRAM\nreset tree + \"no boot ROM\":\nthe CPU waits for a .BIN\nOSD file download router",
          fillcolor = "#fff3cd"];

    cpu [label = "Z-80 computer\nMicrocomputerZ80CPM.vhd\n\nT80 at 10 MHz\nz80_bus_mux (T80 | SSP)\nssp_tramp (reset vector inject)\nI/O decode + read mux",
          fillcolor = "#bbdefb"];

    mem [label = "memory\n\nMMU $B0-$BF: 4 x 16 KB\nframes -> 28-bit physical\ndirect port $BC\n64 KB block RAM @0x08000000\nSDRAM client + CDC + controller",
          fillcolor = "#bbdefb"];

    periph [label = "peripherals (I/O ports)\n\n$80/$81 text terminal + PS/2\n$82/$83 serial ACIA\n$88-$8F SD card (SPI)\n$90-$97 HPS disk image\n$70/$71 RTC\n$C0-$CF, $D0-$D3 timers\n$A0-$A7 + $FF 256 LEDs",
          fillcolor = "#ffcc80"];

    ssp [label = "SSP -- RISC-V debug processor\nssp/rtl/, FemtoRV32-gracilis\n\nits own 128K ROM (Forth monitor),\n64K RAM, register bridge\nparks the Z-80 at an instruction\nboundary, single-steps it, reads and\nwrites physical memory directly",
          fillcolor = "#c8e6c9"];

    snd [label = "sound\n\nMrZ80_PSG wrapper +\n2 x YM2149 (jt49) cores,\nstereo mixers\n$50/$51 and $68/$60\nOSD pan: Mono / ABC / ACB",
          fillcolor = "#e1bee7"];

    fw -> glue [label = "OSD status,\nfiles, keyboard", dir = both];
    glue -> cpu;
    cpu -> mem  [dir = both, label = "MREQ\n+ WAIT", color = "#1565c0"];
    cpu -> periph [dir = both, label = "IORQ", color = "#e65100"];
    cpu -> snd  [dir = both, label = "$50/$51\n$68/$60", color = "#6a1b9a"];
    cpu -> ssp  [dir = both, label = "park, bus engine,\nreset vent, register state", color = "#2e7d32"];
    ssp -> mem  [label = "physical bytes\nwhile parked", color = "#2e7d32"];
    periph -> fw [label = "video, SPI SD,\nLED string, RTS/CTS"];
    snd -> fw    [label = "16-bit L/R", color = "#6a1b9a"];
    mem -> fw    [label = "SDRAM pins", color = "#1565c0"];
    ssp -> fw    [label = "console: serial or\nits own video terminal", color = "#2e7d32"];
}
